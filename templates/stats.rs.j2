#[derive(Debug, Default, PartialEq)]
pub struct {{ section.name | capitalize }}Stats {
    {%- for stat in section.stats %}
    pub {{ stat.name }}: {{ stat.ty | print_ty() }},
    {%- endfor %}
}
{% endfor %}

#[derive(Debug, Default, PartialEq)]
pub struct Stats {
    {%- for section in stats.sections %}
    pub {{ section.name }}: {{ section.name | capitalize }}Stats,
    {%- endfor %}
}

#[allow(unused)]
fn map_sum<K: Eq + Hash>(map: &IndexMap<K, f64>, predicate: impl Fn(&K) -> bool) -> f64 {
    map.iter()
        .filter(|(k, _)| predicate(k))
        .map(|(_, v)| *v)
        .sum()
}

#[allow(unused)]
fn normalize<K: Eq + Hash + Clone>(map: &IndexMap<K, f64>, total: f64) -> IndexMap<K, f64> {
    map.iter()
        .map(|(k, v)| (k.clone(), 100.0 * v / total))
        .collect()
}

#[allow(unused)]
fn topn<K: Eq + Hash + Clone>(map: &IndexMap<K, f64>, n: usize) -> IndexMap<K, f64> {
    let mut entries: Vec<_> = map.iter().collect();
    entries.sort_by(|a, b| b.1.partial_cmp(a.1).unwrap());
    entries.into_iter().take(n).map(|(k, v)| (k.clone(), *v)).collect()
}

#[allow(unused)]
fn percentage(v: f64, total: f64) -> f64 {
    100.0 * v / total
}

#[allow(unused)]
fn ratio(a: f64, b: f64) -> f64 {
    if a + b > 0.0 { 100.0 * a / (a + b) } else { 50.0 }
}

impl From<Metrics> for Stats {
    #[allow(unused_parens)]
    fn from(metrics: Metrics) -> Self {
        let Metrics {
            {%- for metric in metrics %}
            {{ metric.name }},
            {%- endfor %}
        } = metrics;

        {% for stat_let in stats.lets %}
        let {{ stat_let.name }} = {{ stat_let.value | print_expr() }};
        {%- endfor %}

        Self {
            {%- for section in stats.sections %}
            {{ section.name }}: {{ section.name | capitalize }}Stats {
                {%- for stat in section.stats %}
                {{ stat | print_stat_value() }}
                {%- endfor %}
            },
            {%- endfor %}
        }
    }
}

impl fmt::Display for Stats {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        {%- for section in stats.sections %}
        writeln!(f, "{{ section.name }}:")?;
        {%- for stat in section.stats %}
        {%- match stat.ty %}
        {%- when dsl::Ty::Scalar %}
        writeln!(f, "  {{ stat.name }}: {:.2}", self.{{ section.name }}.{{ stat.name }})?;
        {%- when dsl::Ty::Map(_) %}
        writeln!(f, "  {{ stat.name }}:")?;
        let mut entries: Vec<_> = self.{{ section.name }}.{{ stat.name }}.iter().collect();
        entries.sort_by(|a, b| a.0.partial_cmp(b.0).unwrap());
        for (k, v) in entries {
            writeln!(f, "    {}: {:.2}", k, v)?;
        }
        {%- endmatch %}
        {%- endfor %}
        {%- endfor %}
        Ok(())
    }
}
