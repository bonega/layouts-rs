enum StatDiff {
    Improved(f64),
    Regressed(f64),
    Changed(f64),
    Unchanged(f64),
}

impl fmt::Display for StatDiff {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        let fmt_delta = |delta: &f64| {
            if delta.abs() < 1e-9 { format!("{:.2}", delta) }
            else { format!("{:+.2}", delta) }
        };
        match self {
            Self::Improved(delta)  => write!(f, "\x1b[32m{}\x1b[0m", fmt_delta(delta)),
            Self::Regressed(delta) => write!(f, "\x1b[31m{}\x1b[0m", fmt_delta(delta)),
            Self::Changed(delta) => write!(f, "\x1b[38;5;240m{}\x1b[0m", fmt_delta(delta)),
            Self::Unchanged(delta) => write!(f, "\x1b[33m{}\x1b[0m", fmt_delta(delta)),
        }
    }
}

pub struct StatsDiff {
    before: Stats,
    after: Stats,
    targets: Targets,
}

impl StatsDiff {
    pub fn diff(after: Stats, before: Stats, targets: Targets) -> Self {
        Self {
            before,
            after,
            targets,
        }
    }

    fn classify(before_val: f64, after_val: f64, target_val: f64) -> StatDiff {
        let delta = after_val - before_val;
        let gap_before = (before_val - target_val).abs();
        let gap_after = (after_val - target_val).abs();
        let improvement = gap_before - gap_after;

        if improvement > 1e-9 {
            StatDiff::Improved(delta)
        } else if improvement < -1e-9 {
            StatDiff::Regressed(delta)
        } else {
            StatDiff::Unchanged(delta)
        }
    }

    {% for section in stats.sections %}
    {% for stat in section.stats %}
    {% if let Some(target) = self.find_target(section.name, stat.name) %}
    {% match stat.ty %}
    {% when dsl::Ty::Scalar %}
    fn target_for_{{ section.name }}_{{ stat.name }}(&self) -> StatDiff {
        let before_val = self.before.{{ section.name }}.{{ stat.name }};
        let after_val = self.after.{{ section.name }}.{{ stat.name }};
        let delta = after_val - before_val;

        if self.targets.{{ target.name }}.weight == 0.0 {
            return StatDiff::Changed(delta);
        }

        let target_val = self.targets.{{ target.name }}.value;
        Self::classify(before_val, after_val, target_val)
    }

    {% when dsl::Ty::Map(_) %}
    fn target_for_{{ section.name }}_{{ stat.name }}(&self, key: &{{ stat.ty | print_map_key_ty() }}) -> StatDiff {
        let before_val = self.before.{{ section.name }}.{{ stat.name }}.get(key).copied().unwrap_or(0.0);
        let after_val = self.after.{{ section.name }}.{{ stat.name }}.get(key).copied().unwrap_or(0.0);
        let delta = after_val - before_val;

        let Some(target_val) = self.targets.{{ target.name }}.value.get(key).copied() else {
            return StatDiff::Changed(delta);
        };

        let weight = self.targets.{{ target.name }}.weight.get(key).copied().unwrap_or(0.0);
        if weight == 0.0 {
            return StatDiff::Changed(delta);
        }

        Self::classify(before_val, after_val, target_val)
    }
    {% endmatch %}
    {% endif %}
    {% endfor %}
    {% endfor %}
}

impl fmt::Display for StatsDiff {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        {%- for section in stats.sections %}
        writeln!(f, "{{ section.name }}:")?;
        {%- for stat in section.stats %}
        {%- match stat.ty %}
        {%- when dsl::Ty::Scalar %}
        let value = self.after.{{ section.name }}.{{ stat.name }};
        {%- if self.find_target(section.name, stat.name).is_some() %}
        writeln!(f, "  {{ stat.name }}: {value:.2} {}", self.target_for_{{ section.name }}_{{ stat.name }}())?;
        {%- else %}
        writeln!(f, "  {{ stat.name }}: {value:.2}")?;
        {%- endif %}
        {%- when dsl::Ty::Map(_) %}
        writeln!(f, "  {{ stat.name }}:")?;
        let mut entries: Vec<_> = self.after.{{ section.name }}.{{ stat.name }}.iter().collect();
        entries.sort_by(|a, b| a.0.partial_cmp(b.0).unwrap());
        for (k, v) in entries {
            {%- if self.find_target(section.name, stat.name).is_some() %}
            writeln!(f, "    {k}: {v:.2} {}", self.target_for_{{ section.name }}_{{ stat.name }}(k))?;
            {%- else %}
            writeln!(f, "    {k}: {v:.2}")?;
            {%- endif %}
        }
        {%- endmatch %}
        {%- endfor %}
        {%- endfor %}
        Ok(())
    }
}
